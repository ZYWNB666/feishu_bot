APP_ID=cli_a9***************
APP_SECRET=xxxxxxxxxxxxxxxxxxxx
LARK_HOST=https://open.feishu.cn
VERIFICATION_TOKEN=
ENCRYPT_KEY=


# ==================== MySQL配置====================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=config_db
MYSQL_CHARSET=utf8mb4


# ==================== 服务器配置 ====================
# http监听地址和端口
PORT=3000
HOST=0.0.0.0


# Flask调试模式
DEBUG=false


# ==================== 日志配置 ====================
# 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ==================== Flashcat oncall 配置 ====================
FLASHCAT_APP_KEY=
FLASHCAT_SCHEDULE_ID=
FEISHU_USER_ACCESS_TOKEN=
# 电话告警 integration_key（旧接口，severity=phone 时触发）
FLASHCAT_PHONE_INTEGRATION_KEY=
# Flashcat incident channel_id（创建电话告警 incident 时使用）
FLASHCAT_CHANNEL_ID=
# Flashcat phone alert preflight timeout in seconds.
FLASHCAT_PROBE_TIMEOUT=3

# ==================== 趋势告警 V2 与旧试点回退 ====================
# 先执行 20261005 和 20261006 两份迁移。无需逐路由或逐 UID 配置。
# legacy=兼容旧配置；labels=按下面的标签筛选；all=全局自动识别。
TREND_GATE_MODE=legacy
# 标签名精确匹配，值为完整匹配的正则；多个标签同时满足。空对象无效。
# 可改为 {"tenant":"tenant-b4n1c8awyyfn5","alertname":".*(TPOT|TTFT).*"}
TREND_LABEL_MATCHERS={"trend_gate":"true"}
# 以下两个变量仅用于 legacy 模式没有启用策略时的旧 TPOT 试点回退。
TREND_GATE_ENABLED=false
TREND_RULE_UID=tfk3tpot5p0e3f
GRAFANA_API_URL=https://grafana.magikcloud.cn
# 单独配置规则只读 key；缺省时使用现有 GRAFANA_API_KEY。
GRAFANA_RULES_READ_KEY=
VM_QUERY_URL=https://auth-metrics.magikcloud.cn/select/66/prometheus/api/v1/query_range
# 内网无认证时使用内网查询地址，以下两项留空即可。
VM_USER=
VM_PASSWORD=
TREND_DEDUP_SECONDS=300
TREND_CHECK_SECONDS=15
TREND_SENT_CHECK_SECONDS=30
TREND_OBSERVE_SECONDS=120
TREND_HARD_RATIO=1.5
TREND_RISE_RATIO=0.15
TREND_MIN_REQUESTS=20
# 仅旧 UID 策略的缺省值；标签/全局策略默认自动识别，也可在路由策略里显式指定。
TREND_REQUEST_METRIC=magik_model_tpot_ms_count
# 成功率绝对下限：不配置则不启用，数值单位须与 Grafana 查询一致。
TREND_HARD_FLOOR=
TREND_SLOW_WINDOW_SECONDS=600
TREND_CONFIRM_CYCLES=2
TREND_LOG_RETENTION_DAYS=90
TREND_LOG_CLEANUP_SECONDS=3600


# ==================== 性能优化配置（可选，均有默认值） ====================
# ── 数据库连接池 ──
# 连接池大小
MYSQL_POOL_SIZE=10
# 连接池获取连接超时（秒）
MYSQL_POOL_ACQUIRE_TIMEOUT=30

# ── 告警去重缓存 ──
# firing 批次去重 TTL（秒）
ALERT_DEDUP_TTL=300
# resolved 批次去重 TTL（秒）
RESOLVED_DEDUP_TTL=1800
# 各类去重缓存最大条目数（防内存无限增长）
ALERT_DEDUP_CACHE_MAXSIZE=50000

# ── 飞书事件/回调去重 ──
EVENT_CACHE_TTL=3600
EVENT_CACHE_MAXSIZE=20000
CALLBACK_CACHE_TTL=5
CALLBACK_CACHE_MAXSIZE=10000

# ── HTTP 超时（秒）──
FEISHU_API_TIMEOUT=10
FLASHCAT_API_TIMEOUT=10
SILENCE_API_TIMEOUT=30

# ── 重试策略 ──
MAX_RETRIES=3
RETRY_BACKOFF_BASE=2

# ── token 缓存安全余量（秒）──
TOKEN_REFRESH_BUFFER=300

# ── 路由配置静态缓存 ──
# alert_config（含 label_rules）内存缓存 TTL（秒）
ALERT_CONFIG_CACHE_TTL=30

# ── 告警统计默认值 ──
ALERT_STATS_DEFAULT_DAYS=7
ALERT_STATS_DEFAULT_TOP_LIMIT=20
ALERT_STATS_DEFAULT_DETAILS_LIMIT=200

# ── 告警记录 ──
# MAID 随机字符串长度
MAID_LENGTH=20
